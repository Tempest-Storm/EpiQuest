# Port the backend API/WebSocket server listens on.
PORT=3001

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/epiquest

# Base URL of the frontend. Used for CORS, OAuth redirects and the
# Socket.io origin. Must match where the React app is served from.
FRONTEND_URL=http://localhost:5174

# Secret used to sign Express sessions. Use a long random string.
SESSION_SECRET=change_me_session_secret

# Secret used to sign the JWTs issued after login. Use a long random string.
JWT_SECRET=change_me_jwt_secret

# Google OAuth 2.0 credentials (Google Cloud Console → APIs & Services →
# Credentials). The authorized redirect URI must be
# <backend>/auth/google/callback.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
